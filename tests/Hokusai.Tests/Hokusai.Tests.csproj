<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-independent unit tests: SQL normalization, alignment, correlation, inference, state diffs,
       replay on SQLite and code generation golden files. They run on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hokusai.Runtime\Hokusai.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Hokusai.Core\Hokusai.Core.csproj" />
    <ProjectReference Include="..\..\src\Hokusai.Sql\Hokusai.Sql.csproj" />
    <ProjectReference Include="..\..\src\Hokusai.Infer\Hokusai.Infer.csproj" />
    <ProjectReference Include="..\..\src\Hokusai.Verify\Hokusai.Verify.csproj" />
    <ProjectReference Include="..\..\src\Hokusai.Generate\Hokusai.Generate.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Golden files are read from the source tree so they can be regenerated in place. -->
    <Compile Remove="Golden\**" />
    <None Remove="Golden\**" />
  </ItemGroup>
</Project>
