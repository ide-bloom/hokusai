    <PackageVersion Include="System.Data.OleDb" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.154.0" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.2" />
    <PackageVersion Include="Scriban" Version="7.6.1" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>
</Project>
