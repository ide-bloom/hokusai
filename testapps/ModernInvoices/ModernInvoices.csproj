<Project Sdk="Microsoft.NET.Sdk">
  <!-- Modern WinForms app reaching SQLite through ODBC (the SQLite ODBC driver), captured by the in-process agent. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Hokusai.TestApps</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.Odbc" />
  </ItemGroup>
</Project>
