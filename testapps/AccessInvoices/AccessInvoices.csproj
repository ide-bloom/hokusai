<Project Sdk="Microsoft.NET.Sdk">
  <!-- Access variant through the ACE OLE DB provider; captured with row-level state diffs. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Hokusai.TestApps</RootNamespace>
    <!-- ACE is installed as either 32- or 64-bit; build to match the installed provider. -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" />
  </ItemGroup>
</Project>
