<Application x:Class="Hokusai.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Value classes use solid chips with white text so they read well in both light and dark themes. -->
    <SolidColorBrush x:Key="InputBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="DependentBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="GeneratedBrush" Color="#C25E00" />
    <SolidColorBrush x:Key="ConstantBrush" Color="#6A1B9A" />
    <SolidColorBrush x:Key="MismatchBrush" Color="#C62828" />
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Resources>
</Application>
