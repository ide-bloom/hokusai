<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Generated by Hokusai: REST API for the generated actions. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>{{ ns_api }}</RootNamespace>
    <UserSecretsId>{{ user_secrets_id }}</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="{{ versions.aspnet }}" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="{{ versions.aspnet }}" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\{{ name }}.Actions\{{ name }}.Actions.csproj" />
  </ItemGroup>
</Project>
