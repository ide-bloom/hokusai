    <PackageReference Include="System.Data.OleDb" Version="{{ versions.ole_db }}" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="{{ versions.sqlite }}" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="{{ versions.extensions }}" />
  </ItemGroup>
</Project>
