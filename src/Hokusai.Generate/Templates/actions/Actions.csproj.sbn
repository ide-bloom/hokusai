<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by Hokusai: the actions and the Hokusai runtime (as source), shared by the API, MCP server and tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>{{ ns }}</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="{{ versions.sql_client }}" />
