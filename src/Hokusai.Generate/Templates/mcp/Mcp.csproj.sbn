<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by Hokusai: MCP server (stdio) exposing the generated actions as tools. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>{{ ns_mcp }}</RootNamespace>
    <UserSecretsId>{{ user_secrets_id }}</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="{{ versions.mcp }}" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="{{ versions.extensions }}" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\{{ name }}.Actions\{{ name }}.Actions.csproj" />
  </ItemGroup>
</Project>
