<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hokusai.Core\Hokusai.Core.csproj" />
    <ProjectReference Include="..\Hokusai.Infer\Hokusai.Infer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Scriban" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated projects receive the runtime as source, so replay in verification and in generated code is the same code. -->
    <!-- WithCulture=false: "Program.cs.sbn" would otherwise be read as a Czech ("cs") satellite resource. -->
    <EmbeddedResource Include="..\Hokusai.Runtime\*.cs" LogicalName="runtime/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Templates\**\*.sbn" LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hokusai.Tests" />
  </ItemGroup>
</Project>
