{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "x64",
      "inherits": "base",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static" }
    },
    {
      "name": "x86",
      "inherits": "base",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/x86",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x86-windows-static" }
    }
  ],
  "buildPresets": [
    { "name": "x64", "configurePreset": "x64", "configuration": "Release" },
    { "name": "x86", "configurePreset": "x86", "configuration": "Release" }
  ]
}
